cabal-version:      3.14

-- Newer versions complain
name:               websites
version:            1.0.0.0
homepage:           https://github.com/emberdart/websites#readme
license:            AGPL-3.0-only
author:             Ember Dart
maintainer:         cabal@emberdart.co.uk
copyright:          2019-2021 Ember Dart
category:           Web
build-type:         Simple
extra-source-files: README.md

common shared-properties
  default-language:   GHC2024
  default-extensions: UnicodeSyntax

  if !arch(wasm32)
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

  ghc-options:
    -Weverything -Wno-unsafe -Wno-missing-import-lists
    -Wno-missing-export-lists -Wno-implicit-prelude
    -Wno-missing-safe-haskell-mode -Wno-missing-kind-signatures
    -Wno-missing-poly-kind-signatures -Wno-missing-local-signatures
    -Wno-all-missed-specialisations -Wno-missed-specialisations
    -Wno-missing-role-annotations -Wno-unrecognised-warning-flags
    -Werror -haddock

  ghcjs-options:      -dedupe

library
  hs-source-dirs:     lib
  ghc-options:
    -Weverything -Wno-unsafe -Wno-missing-import-lists
    -Wno-missing-export-lists -Wno-implicit-prelude
    -Wno-missing-safe-haskell-mode -Wno-missing-kind-signatures
    -Wno-missing-poly-kind-signatures -Wno-missing-local-signatures
    -Wno-all-missed-specialisations -Wno-missed-specialisations
    -Wno-missing-role-annotations -Wno-unrecognised-warning-flags
    -Werror -haddock

  ghcjs-options:      -dedupe
  default-language:   GHC2024
  default-extensions: UnicodeSyntax
  build-depends:
    , aeson                   ^>=2.2.3
    , base                    ^>=4.22
    , blaze-html              ^>=0.9.2
    , blaze-markup            ^>=0.8.3
    , bytestring              ^>=0.12.2
    , Cabal                   ^>=3.16
    , containers              ^>=0.8
    , directory               ^>=1.3.9
    , email-validate          ^>=2.3.2.21
    , extra                   ^>=1.8
    , feed                    ^>=1.3.2.1
    , filepath                ^>=1.5.4
    , frontmatter             ^>=0.1.0.2
    , lens                    ^>=5.3.3
    , mtl                     ^>=2.3.1
    , network-uri             ^>=2.6.4.2
    , nonempty-containers     ^>=0.3.4.5
    , nonempty-wrapper        ^>=0.1
    , nonempty-wrapper-aeson  ^>=0.1
    , nonempty-wrapper-text   ^>=0.1
    , pandoc                  ^>=3.9
    , req                     ^>=3.13.4
    , sitemap-gen             ^>=0.1
    , text                    ^>=2.1.2
    , time                    ^>=1.16

  -- , dotenv               ^>=0.12
  other-modules:
    Build.BlogPersonal
    Build.BlogTech
    Build.BlogHamRadio
    Build.Blogs
    Build.Personal
    Build.Portfolio
    Build.HamRadio
    Build.Reviews
    Build.Normal
    Build.Sitemap
    Control.Exception.AtomException
    Control.Exception.Atom.CantGenerateFeedException
    Control.Exception.Atom.MissingAtomURIException
    Control.Exception.BlogPostException
    Control.Exception.BlogPost.CommentException
    Control.Exception.BlogPost.InvalidDateException
    Control.Exception.BlogPost.MissingPostIdException
    Control.Exception.BlogPost.ParseFileException
    Data.Foldable.Monoid
    Data.Time.Utils
    Html.BlogPersonal.Header
    Html.BlogPersonal.Index
    Html.BlogPersonal.Page.Blog
    Html.BlogTech.Header
    Html.BlogTech.Index
    Html.BlogTech.Page.Blog
    Html.BlogHamRadio.Header
    Html.BlogHamRadio.Index
    Html.BlogHamRadio.Page.Blog
    Html.Common.Audio
    Html.Common.Blog.Comment
    Html.Common.Blog.Feed
    Html.Common.Blog.Link
    Html.Common.Blog.Post
    Html.Common.Blog.Types
    Html.Common.Bootstrap
    Html.Common.Card
    Html.Common.Contact
    Html.Common.CSS
    Html.Common.Error.NotFound
    Html.Common.GitHub
    Html.Common.Head
    Html.Common.Header
    Html.Common.Icon
    Html.Common.Link
    Html.Common.Page
    Html.Common.Redirect
    Html.Common.Shortcuts
    Html.Common.Social
    Html.Common.Utils
    Html.Personal.Data
    Html.Personal.Header
    Html.Personal.Index
    Html.Personal.Page.About
    Html.Personal.Page.Characters
    Html.Personal.Page.Contact
    Html.Personal.Page.Favourites
    Html.Personal.Page.Health
    Html.Personal.Page.Intro
    Html.Personal.Page.Maths
    Html.Personal.Page.Music
    Html.Personal.Page.Origami
    Html.Personal.Social
    Html.Portfolio.Header
    Html.Portfolio.Index
    Html.Portfolio.Page.Contact
    Html.Portfolio.Page.FreeSoftware
    Html.Portfolio.Page.Portfolio
    Html.HamRadio.Header
    Html.HamRadio.Index
    Html.HamRadio.Page.Contact
    Html.HamRadio.Page.HamRadio
    Html.Reviews.Header
    Html.Reviews.Index
    Html.Reviews.Page.Reviews
    Html.Reviews.Suffix
    Make

  exposed-modules:
    Build
    Data.Env
    Data.Env.Types

executable build
  import:             shared-properties
  hs-source-dirs:     src
  main-is:            Main.hs
  default-language:   GHC2024
  default-extensions: UnicodeSyntax
  build-depends:
    , base      ^>=4.22
    , websites  ^>=1.0

test-suite websites-test
  import:             shared-properties

  if (arch(javascript) || arch(wasm32))
    buildable: False

  hs-source-dirs:     test
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  other-modules:      E2E.Site.CommonSpec
  default-language:   GHC2024
  default-extensions: UnicodeSyntax
  build-depends:
    , aeson              ^>=2.2.3
    , async              ^>=2.2.5
    , base               ^>=4.22
    , hspec              ^>=2.11.15
    , http-client        ^>=0.7.18
    , http-client-tls    ^>=0.4
    , http-types         ^>=0.12.4
    , lens               ^>=5.3.3
    , network-uri        ^>=2.6.4.2
    , nonempty-wrapper   ^>=0.1
    , text               ^>=2.1.2
    , webdriver          ^>=0.12.0.1
    , webdriver-wrapper  ^>=0.2.0.1
    , websites           ^>=1.0
    , witherable         ^>=0.5

  -- , containers           ^>=0.8
  -- , hspec-core ^>=2.11.15
  -- , hspec-expectations ^>=0.8.4
  -- , mtl                  ^>=2.3.1
  -- , process ^>=1.6.25
  -- , QuickCheck ^>=2.18
  -- , random ^>=1.3
  -- , vector ^>=0.13.2
  build-tool-depends: hspec-discover:hspec-discover

benchmark websites-bench
  import:             shared-properties
  hs-source-dirs:     bench
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  other-modules:
  default-language:   GHC2024
  default-extensions: UnicodeSyntax
  build-depends:
    , base       ^>=4.22
    , criterion  ^>=1.6.4
    , websites   ^>=1.0
